rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standalone candidate rules: never deploy over a sibling project's rules.
    match /travelPlanner/v1/users/{uid}/records/{recordId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() { return request.resource.data.ownerId == uid
        && request.resource.data.id == recordId
        && request.resource.data.kind in ['trip','place','item','task','reminder']
        && request.resource.data.revision is int
        && request.resource.data.deleted is bool
        && request.resource.data.updatedAt is string
        && request.resource.data.size() <= 40; }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && resource.data.ownerId == uid && valid()
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false; // versioned tombstones are required for conflict recovery.
    }
  }
}
