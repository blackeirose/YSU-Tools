{
  "name": "ysu-travel-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "stage": "node scripts/stage-release.mjs",
    "test:rules": "vitest run --config vitest.emulator.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@netlify/blobs": "^11.1.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^6.0.2",
    "@netlify/zip-it-and-ship-it": "^16.2.3",
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
