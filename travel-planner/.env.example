# PUBLIC Firebase web configuration only. No secrets in VITE_* values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# true connects ONLY to local demo emulators; never the UMS production project.
VITE_USE_EMULATORS=false
# Optional approved server endpoint. Remains disabled when empty.
VITE_AI_ENDPOINT=
# Optional licensed tile provider. OSM default must follow Tile Usage Policy.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
